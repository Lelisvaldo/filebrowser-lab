# filebrowser-lab: igual ao Dockerfile do Quantum, mas o frontend vem de frontend-lab/.
FROM ghcr.io/gtsteffaniak/ffmpeg:9.0.2-decode AS ffmpeg
FROM golang:alpine AS base
ARG VERSION
ARG REVISION
WORKDIR /app
COPY ./backend ./
RUN apk update && apk add --no-cache gcc musl-dev
RUN go mod download && go run ./scripts/setup-gofitz-cgo
ENV CGO_ENABLED=1
RUN go build -tags analytics,mupdf,musl -ldflags="-w -s \
  -X 'github.com/gtsteffaniak/filebrowser/backend/internal/version.Version=${VERSION}' \
  -X 'github.com/gtsteffaniak/filebrowser/backend/internal/version.CommitSHA=${REVISION}'" \
  -o filebrowser .

FROM node:jod-slim AS nbuild
# filebrowser-lab: compila a interface própria (frontend-lab/) no lugar da do Quantum (frontend/).
WORKDIR /build
COPY ./frontend-lab/package.json ./frontend-lab/package-lock.json ./frontend-lab/
RUN cd frontend-lab && npm ci --maxsockets 1
COPY ./frontend-lab/ ./frontend-lab/
WORKDIR /build/frontend-lab
RUN npm run build:docker

FROM alpine:latest
COPY --from=ffmpeg [ "/ffmpeg", "/ffprobe", "/usr/local/bin/" ]
ENV FILEBROWSER_FFMPEG_PATH="/usr/local/bin/"
ENV FILEBROWSER_DATABASE_PATH="/home/filebrowser/data/database.sqlite"
ENV FILEBROWSER_CONFIG="/home/filebrowser/data/config.yaml"
ENV PATH="$PATH:/home/filebrowser"
RUN apk --no-cache add ca-certificates mailcap tzdata curl 7zip
# LibreOffice (sem interface): abre e converte Office de qualquer geração (HL-119). Só roda quando alguém abre um documento.
RUN apk --no-cache add libreoffice-writer libreoffice-calc libreoffice-impress ttf-liberation ttf-dejavu fontconfig \
 && for p in $(apk info | grep -E '^(llvm[0-9]+-libs|mesa|mesa-gl|mesa-gbm|mesa-dri-gallium|qt6-qtdeclarative|qt6-qtbase-x11|gtk4\.0|gtk\+3\.0|gst-plugins-bad|flite|x265-libs|aom-libs|libsvtav1enc)$'); do \
      apk info -L "$p" | grep '\.so' | sed 's#^#/#' | xargs -r rm -f; done
RUN adduser -D -s /bin/true -u 1000 filebrowser
USER filebrowser
WORKDIR /home/filebrowser
# copy config to two locations for compatibility
COPY --from=base --chown=filebrowser:1000 [ "/app/filebrowser", "./" ]
COPY --from=base --chown=filebrowser:1000 [ "/app/config.yaml", "./data/config.yaml" ]
COPY --from=base --chown=filebrowser:1000 [ "/app/config.yaml", "./" ]
COPY --from=base --chown=filebrowser:1000 [ "/app/reduce-rounded-corners.css", "./" ]
COPY --from=nbuild --chown=filebrowser:1000 [ "/build/backend/internal/web/dist/", "./internal/web/dist/" ]
## sanity checks
RUN [ "filebrowser", "version" ]
RUN [ "ffmpeg", "-version" ]
RUN [ "ffprobe", "-version" ]
RUN printf '{\\rtf1 ola}' > /tmp/t.rtf && HOME=/tmp soffice --headless --norestore "-env:UserInstallation=file:///tmp/p" --convert-to pdf --outdir /tmp /tmp/t.rtf >/dev/null 2>&1 && test -s /tmp/t.pdf && rm -rf /tmp/t.* /tmp/p
# exposing default port for auto discovery.
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:80/health || exit 1
ENTRYPOINT [ "./filebrowser" ]
