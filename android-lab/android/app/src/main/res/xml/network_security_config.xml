<?xml version="1.0" encoding="utf-8"?>
<!-- Confia nos certificados do sistema e nos instalados pelo usuário (o certificado raiz da casa, de https://certificado.lab). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
